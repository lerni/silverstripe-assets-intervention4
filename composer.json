{
	"name": "lerni/silverstripe-assets-intervention4",
	"description": "Runs silverstripe/assets and silverstripe/asset-admin 3.3 on Intervention Image 4 (composer patch)",
	"type": "library",
	"license": "BSD-3-Clause",
	"require": {
		"php": "^8.3",
		"cweagans/composer-patches": "^2",
		"silverstripe/assets": "~3.3.2",
		"intervention/image": "^4.4"
	},
	"conflict": {
		"silverstripe/asset-admin": "<3.3.0 || >=3.4.0",
		"intervention/image-driver-vips": "<4.2.0 || >=4.3.0"
	},
	"provide": {
		"intervention/image": "3.11.99"
	},
	"extra": {
		"patches": {
			"silverstripe/assets": [
				{
					"description": "Read image resource from stream instead of temp file (silverstripe-assets 3.4, upstream PR #716)",
					"url": "https://raw.githubusercontent.com/lerni/silverstripe-assets-intervention4/3.3.0/patches/0001-stream-read-no-tempfile.patch",
					"sha256": "60c8796ae75230f0f62b8df321398f5ab43425c856d8fe54ae87623449922c76"
				},
				{
					"description": "Port InterventionBackend, factory and converter to Intervention Image 4",
					"url": "https://raw.githubusercontent.com/lerni/silverstripe-assets-intervention4/3.3.0/patches/0002-intervention-image-4.patch",
					"sha256": "1377b5530fb7691263950f61c5188a4923febfc226d0f0ad850043ad38a5ae29"
				},
				{
					"description": "Render sequential libvips pipelines to memory before encoding or cloning",
					"url": "https://raw.githubusercontent.com/lerni/silverstripe-assets-intervention4/3.3.0/patches/0004-vips-ensure-in-memory.patch",
					"sha256": "d3cab30425485c99565095f9c7965bfa8e418224c8e12873634daec25e684cce"
				},
				{
					"description": "Reset cached Image_Backend when replacing a file via setFromLocalFile/setFromStream/setFromString",
					"url": "https://raw.githubusercontent.com/lerni/silverstripe-assets-intervention4/3.3.2/patches/0007-reset-image-backend-on-file-replace.patch",
					"sha256": "3f44ed354abe2c133a19fd3cd008ca29991d545a6cb50bc640ebe55faa588808"
				}
			],
			"intervention/image-driver-vips": [
				{
					"description": "Web-tuned JXL effort default (5) in the libvips JXL encoder, complements image-driver-vips #113",
					"url": "https://raw.githubusercontent.com/lerni/silverstripe-assets-intervention4/3.3.1/patches/0006-vips-jxl-effort-default.patch",
					"sha256": "45ba97375193e98603d82aeee5a4c62097596cb94872e141a168e158a2af1e50"
				}
			],
			"silverstripe/asset-admin": [
				{
					"description": "Port ImageEditor to Intervention Image 4 and ensure libvips pipelines are in memory",
					"url": "https://raw.githubusercontent.com/lerni/silverstripe-assets-intervention4/3.3.0/patches/0005-asset-admin-image-editor-intervention-image-4.patch",
					"sha256": "85b884d753bccb7c2d29f9d6fa6e98718a5d7b91d5900b2b5b89514b4c5503bc"
				}
			]
		}
	}
}
