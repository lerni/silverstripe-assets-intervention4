diff --git a/tests/php/ImageTestBase.php b/tests/php/ImageTestBase.php
index 8d86b2e..9c3f1d0 100644
--- a/tests/php/ImageTestBase.php
+++ b/tests/php/ImageTestBase.php
@@ -528,6 +528,91 @@ abstract class ImageTestBase extends SapphireTest
         $this->assertEquals(InterventionBackend::FAILED_INVALID, $cache->get($key .'_reason'));
     }
 
+    public function testLoadFromClassifiesFailures()
+    {
+        $emptyFile = TEMP_PATH . DIRECTORY_SEPARATOR . 'empty-' . uniqid() . '.jpg';
+        file_put_contents($emptyFile, '');
+
+        try {
+            $cases = [
+                'missing' => ['/this/path/does/not/exist.jpg', InterventionBackend::FAILED_MISSING],
+                'not an image' => [__DIR__ . '/ImageTest/not-image.txt', InterventionBackend::FAILED_INVALID],
+                'empty file' => [$emptyFile, InterventionBackend::FAILED_INVALID],
+            ];
+            foreach ($cases as $label => [$path, $expected]) {
+                $backend = new InterventionBackend();
+                $backend->loadFrom($path);
+                $key = $this->getErrorCacheKey(sha1($path), null);
+                $this->assertEquals($expected, $backend->getCache()->get($key . '_reason'), $label);
+            }
+        } finally {
+            unlink($emptyFile);
+        }
+    }
+
+    public function testWriteToAppliesQuality()
+    {
+        $backend = new InterventionBackend();
+        $backend->loadFrom(__DIR__ . '/ImageTest/test-image-high-quality.jpg');
+
+        $sizes = [];
+        foreach ([100, 1] as $quality) {
+            $path = TEMP_PATH . DIRECTORY_SEPARATOR . 'quality-' . $quality . '-' . uniqid() . '.jpg';
+            try {
+                $this->assertTrue($backend->setQuality($quality)->writeTo($path));
+                $sizes[$quality] = filesize($path);
+            } finally {
+                @unlink($path);
+            }
+        }
+        $this->assertLessThan($sizes[100], $sizes[1], 'Quality is not passed on to the encoder in writeTo()');
+    }
+
+    public function testWriteToUnsupportedExtensionFails()
+    {
+        $backend = new InterventionBackend();
+        $backend->loadFrom(__DIR__ . '/ImageTest/test-image.png');
+        $path = TEMP_PATH . DIRECTORY_SEPARATOR . 'unsupported-' . uniqid() . '.notaformat';
+
+        $this->assertFalse($backend->writeTo($path));
+        $this->assertFileDoesNotExist($path);
+    }
+
+    public function testPaddedResizeTransparency()
+    {
+        $backend = new InterventionBackend();
+        $backend->loadFrom(__DIR__ . '/ImageTest/test-image.png');
+
+        // The padding area is the top left corner for a wide canvas
+        $cases = [
+            'opaque by default' => [0, 255],
+            'half transparent' => [50, 128],
+            'fully transparent' => [100, 0],
+        ];
+        foreach ($cases as $label => [$percent, $expectedAlpha]) {
+            $padded = $backend->paddedResize(600, 100, 'FF0000', $percent);
+            $color = $padded->getImageResource()->colorAt(0, 0);
+            $this->assertEqualsWithDelta($expectedAlpha, $color->alpha()->value(), 3, $label);
+            if ($percent < 100) {
+                $this->assertSame(255, $color->red()->value(), $label);
+            }
+        }
+    }
+
+    public function testChainedResizeAndConvert()
+    {
+        /** @var Image $image */
+        $image = $this->objFromFixture(Image::class, 'imageWithTitle');
+        $scaled = $image->ScaleMaxHeight(150);
+        $this->assertNotNull($scaled);
+        $this->assertSame(150, $scaled->getHeight());
+
+        $converted = $scaled->Convert('webp');
+        $this->assertNotNull($converted);
+        $this->assertTrue($converted->exists());
+        $this->assertSame(150, $converted->getHeight());
+    }
+
     /**
      * Test that propertes from the source Image are inherited by resampled images
      */
